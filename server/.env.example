# Groq writes the per-panel comic scripts (required).
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Groq cannot generate images. This key paints the panels and is what keeps
# new comics matching the existing hand-painted step art.
GEMINI_API_KEY=AIza...
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# auto | gemini | openai | pollinations | svg
IMAGE_PROVIDER=auto
PORT=3000
