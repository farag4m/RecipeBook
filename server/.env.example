# OpenRouter runs both halves of the comic pipeline: the text model writes the
# panel scripts, and an image model on the same key paints them.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# auto | openrouter | gemini | openai | pollinations | svg
IMAGE_PROVIDER=auto

# Optional direct-to-provider keys, used if OpenRouter is unset or failing.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Recipes and comic art. Render free web services have no persistent disk.
DATABASE_URL=postgresql://...
PORT=3000
